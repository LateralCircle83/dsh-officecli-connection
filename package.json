{
  "name": "dsh-officecli-connection",
  "version": "0.6.3",
  "private": false,
  "description": "Point the Harness at your own OfficeCLI binary: one tool, and ten bundled guides injected as skills behind one workflow entry point.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "officecli",
    "office",
    "pptx",
    "docx",
    "xlsx"
  ],
  "scripts": {
    "test": "node test/split.test.mjs && node test/resolve.test.mjs && node test/client-smoke.mjs && node test/provider-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LateralCircle83/dsh-officecli-connection.git"
  },
  "homepage": "https://github.com/LateralCircle83/dsh-officecli-connection#readme",
  "bugs": {
    "url": "https://github.com/LateralCircle83/dsh-officecli-connection/issues"
  }
}
